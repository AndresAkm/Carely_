PORT=9000
MONGODB_URI=mongodb://localhost:27017/carely
SESSION_SECRET=change-this-secret
NODE_ENV=development

# Logs
LOG_LEVEL=debug
LOG_DIR=logs
# Días de retención de la auditoría en base de datos (índice TTL)
AUDIT_RETENTION_DAYS=180

# Supabase Storage (S3-compatible)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=tu-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=tu-secret-access-key
SUPABASE_STORAGE_BUCKET=carely-images

# Correo (SMTP) - Envío de respaldo de base de datos
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu-app-password
MAIL_BACKUP_TO=destinatario@correo.com