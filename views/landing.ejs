<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <div class="page-wrapper">
        <%- include('partials/navbar') %>

        <section class="hero-section">
            <div class="container">
                <div class="row align-items-center min-vh-85">
                    <div class="col-lg-6 hero-content">
                        <span class="badge-hero">Bienestar y Belleza</span>
                        <h1 class="hero-title">Tu bienestar es nuestra <span class="text-highlight">prioridad</span></h1>
                        <p class="hero-description">Descubre una selección cuidadosamente curada de productos de cuidado personal, diseñados para consentirte y realzar tu belleza natural.</p>
                        <div class="hero-cta d-flex flex-wrap gap-3">
                            <a href="/catalogo" class="btn btn-carely-primary btn-lg">
                                <i class="bi bi-shop me-2"></i>Ver Catálogo
                            </a>
                            <a href="#" class="btn btn-carely-outline btn-lg">
                                Crear Cuenta
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6 hero-visual">
                        <div class="hero-image-wrapper">
                            <div class="hero-bg-shape"></div>
                            <img src="/images/hero-placeholder.svg" alt="Cuidado personal" class="hero-img">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="destacados" class="section-padding featured-section">
            <div class="container">
                <div class="section-header text-center">
                    <span class="section-badge">Lo Más Vendido</span>
                    <h2 class="section-title">Productos Destacados</h2>
                    <p class="section-subtitle">Los favoritos de nuestra comunidad que no pueden faltar en tu rutina.</p>
                </div>
                <div class="row g-4 mt-4">
                    <% featuredProducts.forEach(function(product, index) { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="product-card card-carely h-100">
                            <div class="product-image-wrapper">
                                <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
                                <% } else { %>
                                <div class="product-image-placeholder">
                                    <i class="bi bi-box"></i>
                                </div>
                                <% } %>
                                <span class="product-badge">Destacado</span>
                            </div>
                            <div class="product-info">
                                <span class="product-category"><%= product.category.name %></span>
                                <h3 class="product-name"><%= product.name %></h3>
                                <% if (product.description) { %>
                                <p class="product-description"><%= product.description.substring(0, 80) %></p>
                                <% } %>
                                <div class="product-footer">
                                    <span class="product-price">$<%= product.price.toFixed(2) %></span>
                                    <% if (product.stock > 0) { %>
                                    <span class="product-stock in-stock">
                                        <i class="bi bi-check-circle-fill"></i>
                                        En stock
                                    </span>
                                    <% } else { %>
                                    <span class="product-stock out-of-stock">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Agotado
                                    </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <div class="text-center mt-5">
                    <a href="/catalogo" class="btn btn-carely-primary btn-lg">
                        Ver Catálogo Completo
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </section>

        <section id="beneficios" class="section-padding benefits-section">
            <div class="container">
                <div class="section-header text-center">
                    <span class="section-badge">¿Por qué nos eligen?</span>
                    <h2 class="section-title">Beneficios de elegir Carely</h2>
                    <p class="section-subtitle">Nos preocupamos por ofrecerte la mejor experiencia de cuidado personal.</p>
                </div>
                <div class="row g-4 mt-4">
                    <% benefits.forEach(function(benefit) { %>
                    <div class="col-md-6 col-lg-3">
                        <div class="benefit-card card-carely h-100">
                            <div class="benefit-icon">
                                <i class="bi <%= benefit.icon %>"></i>
                            </div>
                            <h3 class="benefit-title"><%= benefit.title %></h3>
                            <p class="benefit-description"><%= benefit.description %></p>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <section id="categorias" class="section-padding categories-section">
            <div class="container">
                <div class="section-header text-center">
                    <span class="section-badge">Nuestras Categorías</span>
                    <h2 class="section-title">Explora por categoría</h2>
                    <p class="section-subtitle">Encuentra todo lo que necesitas para tu rutina de cuidado personal.</p>
                </div>
                <div class="row g-4 mt-4">
                    <% categories.forEach(function(category) { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="category-card card-carely h-100">
                            <div class="category-icon">
                                <i class="bi <%= category.icon %>"></i>
                            </div>
                            <h3 class="category-name"><%= category.name %></h3>
                            <p class="category-description"><%= category.description %></p>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <section id="por-que-carely" class="section-padding why-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0">
                        <div class="why-image-wrapper">
                            <div class="why-bg-shape"></div>
                            <img src="/images/about-placeholder.svg" alt="Sobre Carely" class="why-img">
                        </div>
                    </div>
                    <div class="col-lg-5 offset-lg-1">
                        <span class="section-badge">Sobre Carely</span>
                        <h2 class="section-title text-start">¿Por qué elegir Carely?</h2>
                        <p class="section-subtitle text-start mb-5">En Carely creemos que el cuidado personal es una forma de amor propio. Por eso seleccionamos los mejores productos para ti.</p>
                        <div class="why-list">
                            <% whyUs.forEach(function(item) { %>
                            <div class="why-item d-flex gap-3 mb-4">
                                <div class="why-item-icon flex-shrink-0">
                                    <i class="bi <%= item.icon %>"></i>
                                </div>
                                <div>
                                    <h4 class="why-item-title"><%= item.title %></h4>
                                    <p class="why-item-description mb-0"><%= item.description %></p>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="cta-section section-padding">
            <div class="container">
                <div class="cta-card text-center">
                    <h2 class="cta-title">Comienza tu experiencia Carely</h2>
                    <p class="cta-description">Únete a nuestra comunidad y descubre una nueva forma de consentirte.</p>
                    <a href="#" class="btn btn-carely-primary btn-lg">
                        Crear mi Cuenta Gratis
                        <i class="bi bi-heart ms-2"></i>
                    </a>
                </div>
            </div>
        </section>

        <%- include('partials/footer') %>
    </div>

    <%- include('partials/scripts') %>
</body>
</html>
