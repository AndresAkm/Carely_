<div class="dashboard-page-header">
    <div>
        <h1 class="dashboard-heading"><%= category ? 'Editar categoría' : 'Nueva categoría' %></h1>
        <p class="dashboard-muted">Completa la información de la categoría.</p>
    </div>
    <a href="/dashboard/categorias" class="btn btn-carely-outline">Volver</a>
</div>
<div class="dashboard-card dashboard-form-card">
    <div class="dashboard-card-body">
        <% if (error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4"><i class="bi bi-exclamation-circle-fill"></i><span><%= error %></span></div>
        <% } %>
        <form method="post" enctype="multipart/form-data" novalidate onsubmit="const button=this.querySelector('[type=submit]'); if (button.disabled) return false; button.disabled=true; button.textContent='Guardando...';">
            <div class="dashboard-field">
                <label for="id_name">Nombre</label>
                <input id="id_name" name="name" type="text" class="form-control" value="<%= formData.name || '' %>" required>
            </div>
            <div class="dashboard-field">
                <label for="id_description">Descripción</label>
                <textarea id="id_description" name="description" class="form-control" rows="3"><%= formData.description || '' %></textarea>
            </div>
            <div class="dashboard-field">
                <label for="id_icon">Icono (Bootstrap Icons)</label>
                <input id="id_icon" name="icon" type="text" class="form-control" value="<%= formData.icon || 'bi-tag' %>" required>
                <small>Ej: bi-droplet, bi-box, bi-heart, bi-tag</small>
            </div>
            <div class="dashboard-field">
                <label for="id_image">Imagen (URL)</label>
                <input id="id_image" name="image" type="text" class="form-control" value="<%= formData.image || '' %>" placeholder="/images/categoria.jpg">
                <small>Ingresa una URL de imagen o deja vacío para usar el marcador de posición.</small>
            </div>
            <div class="dashboard-field">
                <label for="id_order">Orden</label>
                <input id="id_order" name="order" type="number" min="0" class="form-control" value="<%= formData.order || 0 %>">
            </div>
            <div class="dashboard-field form-check">
                <input id="id_isActive" name="isActive" type="checkbox" class="form-check-input" <%= formData.isActive === false ? '' : 'checked' %>>
                <label class="form-check-label" for="id_isActive">Activa</label>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-4">
                <a href="/dashboard/categorias" class="btn btn-carely-outline">Cancelar</a>
                <button type="submit" class="btn btn-carely-primary">Guardar categoría</button>
            </div>
        </form>
    </div>
</div>