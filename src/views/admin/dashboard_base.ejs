<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body class="dashboard-page">
    <div class="dashboard-layout">
        <%- include('sidebar') %>
        <div class="dashboard-main">
            <header class="dashboard-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()"><i class="bi bi-list fs-4"></i></button>
                    <h2 class="topbar-title mb-0"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Administración' %></h2>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="/" class="btn btn-sm btn-carely-outline"><i class="bi bi-globe me-1"></i>Ver Sitio</a>
                    <form action="/auth/logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-carely-outline text-danger border-danger"><i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión</button>
                    </form>
                </div>
            </header>
            <div class="dashboard-content">
                <%- include('../partials/flash') %>
                <%- typeof bodyContent !== 'undefined' ? bodyContent : '' %>
            </div>
        </div>
    </div>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
    <%- include('../partials/scripts') %>
    <script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('show');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    }
    </script>
</body>
</html>
