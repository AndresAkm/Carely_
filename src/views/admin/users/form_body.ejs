<div class="dashboard-page-header">
    <div>
        <h1 class="dashboard-heading"><%= user ? 'Editar usuario' : 'Nuevo usuario' %></h1>
        <p class="dashboard-muted">Gestiona los datos y permisos de la cuenta.</p>
    </div>
    <a href="/dashboard/usuarios" class="btn btn-carely-outline">Volver</a>
</div>

<div class="dashboard-card dashboard-form-card">
    <div class="dashboard-card-body">
        <% if (error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4"><i class="bi bi-exclamation-circle-fill"></i><span><%= error %></span></div>
        <% } %>
        <form method="post" novalidate class="dashboard-user-form">
            <div class="dashboard-field">
                <label for="id_firstName">Nombre</label>
                <input id="id_firstName" name="firstName" type="text" class="form-control" value="<%= formData.firstName || '' %>" required>
            </div>
            <div class="dashboard-field">
                <label for="id_lastName">Apellidos</label>
                <input id="id_lastName" name="lastName" type="text" class="form-control" value="<%= formData.lastName || '' %>">
            </div>
            <div class="dashboard-field">
                <label for="id_email">Correo electrónico</label>
                <input id="id_email" name="email" type="email" class="form-control" value="<%= formData.email || '' %>" required>
            </div>
            <div class="dashboard-field">
                <label for="id_phone">Teléfono</label>
                <input id="id_phone" name="phone" type="text" class="form-control" value="<%= formData.phone || '' %>">
            </div>
            <% if (!user) { %>
            <div class="dashboard-field">
                <label for="id_password">Contraseña</label>
                <input id="id_password" name="password" type="password" class="form-control" placeholder="Mínimo 8 caracteres" required>
            </div>
            <% } %>
            <div class="dashboard-field">
                <label for="id_role">Rol</label>
                <select id="id_role" name="role" class="form-control">
                    <option value="client" <%= (formData.role || 'client') === 'client' ? 'selected' : '' %>>Cliente</option>
                    <option value="admin" <%= formData.role === 'admin' ? 'selected' : '' %>>Administrador</option>
                </select>
            </div>
            <div class="dashboard-field form-check">
                <input id="id_isActive" name="isActive" type="checkbox" class="form-check-input" <%= formData.isActive === false ? '' : 'checked' %>>
                <label class="form-check-label" for="id_isActive">Activo</label>
            </div>
            <div class="d-flex gap-2 justify-content-end form-actions">
                <a href="/dashboard/usuarios" class="btn btn-carely-outline">Cancelar</a>
                <button class="btn btn-carely-primary"><%= user ? 'Guardar usuario' : 'Crear usuario' %></button>
            </div>
        </form>
    </div>
</div>
