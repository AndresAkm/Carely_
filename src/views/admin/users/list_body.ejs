<div class="dashboard-page-header">
    <div>
        <h1 class="dashboard-heading">Usuarios</h1>
        <p class="dashboard-muted">Administra las cuentas y accesos de Carely.</p>
    </div>
    <a href="/dashboard/usuarios/nuevo" class="btn btn-carely-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo usuario</a>
</div>

<div class="dashboard-card dashboard-filter-card mb-4">
    <div class="dashboard-card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input class="form-control" type="search" name="q" value="<%= query.q || '' %>" placeholder="Buscar por nombre o correo">
            </div>
            <div class="col-md-2">
                <select class="form-control" name="role">
                    <option value="">Todos los roles</option>
                    <option value="client" <%= query.role === 'client' ? 'selected' : '' %>>Cliente</option>
                    <option value="admin" <%= query.role === 'admin' ? 'selected' : '' %>>Administrador</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-control" name="status">
                    <option value="">Todos los estados</option>
                    <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Activos</option>
                    <option value="inactive" <%= query.status === 'inactive' ? 'selected' : '' %>>Inactivos</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-carely-outline w-100" type="submit"><i class="bi bi-search"></i> Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="dashboard-card">
    <div class="dashboard-card-body p-0">
        <div class="table-responsive">
            <table class="table dashboard-table align-middle mb-0">
                <thead>
                    <tr><th>Usuario</th><th>Teléfono</th><th>Rol</th><th>Estado</th><th>Registro</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    <% users.forEach(function(u) { %>
                    <tr>
                        <td>
                            <strong><%= u.firstName %> <%= u.lastName %></strong>
                            <small class="d-block text-secondary"><%= u.email %></small>
                        </td>
                        <td><%= u.phone || '-' %></td>
                        <td>
                            <% if (u.role === 'admin') { %>
                            <span class="status-badge status-badge--active">Administrador</span>
                            <% } else { %>
                            <span class="status-badge status-badge--inactive">Cliente</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (u.isActive) { %>
                            <span class="status-badge status-badge--active">Activo</span>
                            <% } else { %>
                            <span class="status-badge status-badge--inactive">Inactivo</span>
                            <% } %>
                        </td>
                        <td><%= new Date(u.createdAt).toLocaleDateString('es-CO') %></td>
                        <td class="text-end">
                            <a href="/dashboard/usuarios/<%= u._id %>/editar" class="btn btn-sm btn-carely-outline" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a href="/dashboard/usuarios/<%= u._id %>/password" class="btn btn-sm btn-carely-outline" title="Cambiar contraseña"><i class="bi bi-key"></i></a>
                            <form action="/dashboard/usuarios/<%= u._id %>/estado" method="post" class="d-inline">
                                <% if (u.isActive) { %>
                                <button class="btn btn-sm btn-outline-danger" title="Desactivar"><i class="bi bi-person-dash"></i></button>
                                <% } else { %>
                                <button class="btn btn-sm btn-outline-success" title="Activar"><i class="bi bi-person-check"></i></button>
                                <% } %>
                            </form>
                            <a href="/dashboard/usuarios/<%= u._id %>/eliminar" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                    <% }); %>
                    <% if (users.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-5 text-secondary">No hay usuarios que coincidan con los filtros.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<% if (pages > 1) { %>
<nav class="dashboard-pagination" aria-label="Paginación de usuarios">
    <ul class="pagination justify-content-center mb-0">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?<%= 'q=' + encodeURIComponent(query.q || '') + '&role=' + (query.role || '') + '&status=' + (query.status || '') + '&page=' + (page - 1) %>">‹</a></li>
        <% for (var i = 1; i <= pages; i++) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?<%= 'q=' + encodeURIComponent(query.q || '') + '&role=' + (query.role || '') + '&status=' + (query.status || '') + '&page=' + i %>"><%= i %></a></li>
        <% } %>
        <li class="page-item <%= page >= pages ? 'disabled' : '' %>"><a class="page-link" href="?<%= 'q=' + encodeURIComponent(query.q || '') + '&role=' + (query.role || '') + '&status=' + (query.status || '') + '&page=' + (page + 1) %>">›</a></li>
    </ul>
</nav>
<% } %>
