<div class="dashboard-page-header">
    <div>
        <h1 class="dashboard-heading">Cambiar contraseña</h1>
        <p class="dashboard-muted">Actualiza la contraseña de <%= user.email %>.</p>
    </div>
    <a href="/dashboard/usuarios" class="btn btn-carely-outline">Volver</a>
</div>
<div class="dashboard-card dashboard-form-card">
    <div class="dashboard-card-body">
        <% if (error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4"><i class="bi bi-exclamation-circle-fill"></i><span><%= error %></span></div>
        <% } %>
        <form method="post">
            <div class="dashboard-field">
                <label for="id_password">Nueva contraseña</label>
                <input id="id_password" name="password" type="password" class="form-control" placeholder="Mínimo 8 caracteres" required>
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-carely-primary">Guardar contraseña</button>
            </div>
        </form>
    </div>
</div>
