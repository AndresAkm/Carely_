<footer class="c-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="c-nav__brand" style="margin-bottom:16px">
                    <span class="c-nav__brand-icon"><i class="bi bi-droplet"></i></span>
                    <span class="brand-text" style="color:#fff">Carely</span>
                </div>
                <p>Tu tienda de cuidado personal de confianza. Productos originales, asesoria personalizada y envios rapidos.</p>
                <div class="footer-social">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="TikTok"><i class="bi bi-music-note-beamed"></i></a>
                    <a href="#" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                </div>
            </div>
            <% if (typeof categories !== 'undefined' && categories) { %>
            <div class="footer-col">
                <h5>Categorias</h5>
                <ul>
                    <% categories.forEach(function(cat) { %>
                    <li><a href="/catalogo?category=<%= encodeURIComponent(cat.name) %>"><%= cat.name %></a></li>
                    <% }); %>
                </ul>
            </div>
            <% } else { %>
            <div class="footer-col">
                <h5>Categorias</h5>
                <ul>
                    <li><a href="#">Cuidado Facial</a></li>
                    <li><a href="#">Cuidado Corporal</a></li>
                    <li><a href="#">Cuidado Capilar</a></li>
                    <li><a href="#">Maquillaje</a></li>
                    <li><a href="#">Fragancias</a></li>
                </ul>
            </div>
            <% } %>
            <div class="footer-col">
                <h5>Ayuda</h5>
                <ul>
                    <li><a href="#">Contacto</a></li>
                    <li><a href="#">Envios</a></li>
                    <li><a href="#">Devoluciones</a></li>
                    <li><a href="#">FAQ</a></li>
                    <li><a href="#">Terminos</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Contacto</h5>
                <ul class="footer-contact">
                    <li><i class="bi bi-envelope"></i> hola@carely.com</li>
                    <li><i class="bi bi-telephone"></i> +52 55 1234 5678</li>
                    <li><i class="bi bi-geo-alt"></i> Ciudad de Mexico, MX</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <%= new Date().getFullYear() %> Carely. Todos los derechos reservados.</p>
        </div>
    </div>
</footer>
