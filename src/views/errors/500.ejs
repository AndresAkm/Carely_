<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="page-wrapper">
        <%- include('../partials/navbar') %>

        <section class="c-section c-section--white" style="min-height: 70vh; display: flex; align-items: center;">
            <div class="container text-center">
                <i class="bi bi-exclamation-triangle" style="font-size: 5rem; color: var(--accent);"></i>
                <h1 class="mt-4" style="font-size: 3rem; font-weight: 700;">Error del Servidor</h1>
                <p class="mt-3" style="font-size: 1.2rem; color: var(--clr-text-2);">
                    <%= message %>
                </p>
                <% if (typeof stack !== 'undefined' && stack) { %>
                <pre class="mt-4 p-4 text-start" style="background: var(--clr-bg-2); border-radius: 12px; font-size: 0.85rem; overflow-x: auto; max-width: 800px; margin-left: auto; margin-right: auto;"><%= stack %></pre>
                <% } %>
                <a href="/" class="c-btn c-btn--primary c-btn--lg mt-4">
                    <i class="bi bi-house me-2"></i>Volver al Inicio
                </a>
            </div>
        </section>

        <%- include('../partials/footer') %>
    </div>

    <%- include('../partials/scripts') %>
</body>
</html>
